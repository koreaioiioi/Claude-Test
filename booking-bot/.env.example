# 이 파일을 .env로 복사한 뒤 실제 값으로 채워주세요. (.env는 git에 커밋되지 않습니다)
# cp .env.example .env

# 예약 페이지 주소
BOOKING_URL=https://valet.amanopark.co.kr/booking

# 예약자 정보 (실제 값으로 채워주세요)
CUSTOMER_NAME=
CUSTOMER_PHONE=
CAR_NUMBER=
DESIRED_DATE=2026-09-10
DESIRED_TIME=14:00

# 재시도 간격(초). 매 시도마다 이 범위에서 무작위로 대기합니다.
RETRY_MIN_INTERVAL_SEC=40
RETRY_MAX_INTERVAL_SEC=70

# 안전장치(선택). 비워두면 "성공할 때까지 무제한"으로 동작합니다.
MAX_ATTEMPTS=
MAX_RUNTIME_MINUTES=

# 브라우저를 화면에 띄워서 직접 보고 싶다면 false로 변경
HEADLESS=true

# 성공/중단 시 알림을 받을 Slack/Discord 등의 Incoming Webhook URL (선택)
WEBHOOK_URL=

# 이 샌드박스에 미리 설치된 Chromium을 쓰기 위한 값 (실제 사용 환경에서는 비워두세요)
PLAYWRIGHT_EXECUTABLE_PATH=
